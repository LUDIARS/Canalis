include_guard(GLOBAL)
# 依存はこのファイルだけで宣言する。版はすべて URL_HASH / commit で固定する。
# 版とハッシュは Discutere native (cmake/DiDependencies.cmake) と同じ。取り込みの検査は native/docs/DEPENDENCIES.md。
# 取得済みのものを使うときは -DFETCHCONTENT_SOURCE_DIR_<NAME>=<展開先> を渡す (BOOST / JSON) と -DLORICA_SOURCE_DIR=<clone>。
#
# 他のプロジェクト (Discutere native・Tirocinium native) から add_subdirectory で組み込むとき:
#   - 親が同じ名前 (json / boost / lorica) で同じ版を FetchContent_Declare していれば、それを使う (先の宣言が勝つ)。
#   - 親がすでに Lorica::boundary / nlohmann_json を作っていれば、ここでは作らない。
#   - 親が Boost.Beast の分離コンパイルの単位 (boost/beast/src.hpp) をすでにコンパイルしているなら、
#     -DCANALIS_COMPILE_BEAST=OFF にする (同じ関数が二重にリンクされるのを避ける)。

find_package(OpenSSL 3 REQUIRED)
find_package(Threads REQUIRED)

# nlohmann_json 3.11.3
set(JSON_BuildTests OFF CACHE BOOL "" FORCE)
set(JSON_Install OFF CACHE BOOL "" FORCE)
FetchContent_Declare(json URL https://github.com/nlohmann/json/releases/download/v3.11.3/json.tar.xz
  URL_HASH SHA256=d6c65aca6b1ed68e7a182f4757257b107ae403032760ed6ef121c9d55e81757d)

# Boost 1.87.0 (Asio / Beast のヘッダだけを使う。SOURCE_SUBDIR に存在しない名前を渡し、ビルドさせない)
FetchContent_Declare(boost URL https://github.com/boostorg/boost/releases/download/boost-1.87.0/boost-1.87.0-b2-nodocs.zip
  URL_HASH SHA256=40efbb1f38b8cf186fd7bb12809f561ae1c233bae0f75146862e9bfce77d0d42
  SOURCE_SUBDIR canalis-header-only)

# Lorica (commit 固定)。ローカルの clone を使うときは -DLORICA_SOURCE_DIR=<path>。
set(LORICA_SOURCE_DIR "" CACHE PATH "Local Lorica checkout (empty = fetch the pinned commit)")
set(LORICA_BUILD_PROTECTION OFF CACHE BOOL "" FORCE)
set(LORICA_BUILD_TESTS OFF CACHE BOOL "" FORCE)
if(TARGET Lorica::boundary)
  # 親のプロジェクトがすでに用意している
elseif(LORICA_SOURCE_DIR)
  add_subdirectory(${LORICA_SOURCE_DIR} ${CMAKE_BINARY_DIR}/_lorica EXCLUDE_FROM_ALL)
else()
  FetchContent_Declare(lorica GIT_REPOSITORY https://github.com/LUDIARS/Lorica.git
    GIT_TAG cab4f12086e30484f249d1b4aa479bf7cdec13a9)
  FetchContent_MakeAvailable(lorica)
endif()

if(NOT TARGET nlohmann_json::nlohmann_json)
  FetchContent_MakeAvailable(json)
endif()
FetchContent_MakeAvailable(boost)

add_library(canalis_boost INTERFACE)
target_include_directories(canalis_boost SYSTEM INTERFACE ${boost_SOURCE_DIR})
# Beast は分離コンパイル: 実装 (.ipp) は生成した 1 単位 (beast_src.cpp) にだけ置く (Discutere と同じ)。
# 親がその単位をすでにコンパイルしているときは CANALIS_COMPILE_BEAST=OFF にして、ここでは作らない。
option(CANALIS_COMPILE_BEAST "Compile the Boost.Beast separate-compilation unit in canalis_infra" ON)
target_compile_definitions(canalis_boost INTERFACE BOOST_ERROR_CODE_HEADER_ONLY BOOST_ASIO_NO_DEPRECATED
  BOOST_BEAST_USE_STD_STRING_VIEW BOOST_BEAST_SEPARATE_COMPILATION)
set(CANALIS_BEAST_SRC "")
if(CANALIS_COMPILE_BEAST)
  set(CANALIS_BEAST_SRC ${CMAKE_CURRENT_BINARY_DIR}/generated/canalis_beast_src.cpp)
  file(WRITE ${CANALIS_BEAST_SRC} "// Generated by CanalisDependencies.cmake. Do not edit.
#include <boost/beast/src.hpp>
")
endif()
if(WIN32)
  target_link_libraries(canalis_boost INTERFACE ws2_32 mswsock)
endif()
